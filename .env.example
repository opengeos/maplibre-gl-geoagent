# Copy this file to .env and fill in the values for local development.
#
# Google Cloud OAuth 2.0 Client ID for a Web application.
# Add your local/dev origin, for example: http://localhost:5173
VITE_GEE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com

# Optional default Google Cloud project ID with Earth Engine enabled.
# If omitted, users can enter their own project ID in the GeoAgent panel.
VITE_GEE_PROJECT_ID=
